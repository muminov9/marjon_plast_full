PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret
# Neon Postgres ulanishi (Vercel/Render/cloud uchun). neon.tech da bepul bazani yarating va quyidagini to'ldiring:
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/marjon?sslmode=require
# Supabase ishlatmoqchi bo'lsangiz ham DATABASE_URL ga uning PostgreSQL connection stringini yozing.

# Production uchun: NODE_ENV=production qilinsa, JWT_SECRET albatta o'zgarmagan bo'lsa server ishga tushmaydi.
# NODE_ENV=production

# Xavfsizlik (ixtiyoriy):
# ALLOWED_ORIGINS=https://sizning-domeningiz.com,https://ikkinchi-domen.com
# RATE_LIMIT=600              # 15 daqiqada IP dan ruxsat etilgan so'rovlar soni
# BACKUP_RETENTION=14         # Masofaviy (cloud) zaxira nusxalar necha kun saqlanadi